# CORS: comma-separated origins, or * for allow all
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=*

# Rate limit: max requests per minute per IP (0 = disabled by default). Set to e.g. 60 to enable.
# RATE_LIMIT_PER_MINUTE=0
# RATE_LIMIT_PER_MINUTE=60

# Optional: require X-API-Key header on all /api/* requests (except /api/health, /api/ready)
# API_KEY=your-secret-key

# Optional: GitHub token for update check (higher rate limit; avoids 403)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# WebDownloader systemd service (Ubuntu / Linux)
# 1. Copy: sudo cp deploy/webdownloader.service /etc/systemd/system/
# 2. Edit paths: sudo nano /etc/systemd/system/webdownloader.service
#    Set User=, Group=, and paths below to your install directory.
# 3. Reload and enable: sudo systemctl daemon-reload && sudo systemctl enable webdownloader
# 4. Start: sudo systemctl start webdownloader
# 5. Check: sudo systemctl status webdownloader

[Unit]
Description=WebDownloader (backend + static frontend)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/webdownloader/backend
Environment="PATH=/opt/webdownloader/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/webdownloader/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
